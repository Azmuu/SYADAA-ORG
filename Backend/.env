PORT=5001

MONGO_URI=mongodb://127.0.0.1:27017/syada_org

JWT_SECRET=syada_secret_key_123

# Email (no paid API):
# - MAIL_USE_ETHEREAL=true → free Ethereal test mail; server prints a browser preview link (needs internet).
# - MAIL_USE_ETHEREAL=false and no MAIL_HOST → no email; password in admin UI + server console.
# - Real inbox: set MAIL_HOST + MAIL_USER + MAIL_PASS (e.g. Gmail app password).
# Login link inside emails (change port if Vite uses another, e.g. 5174):
FRONTEND_LOGIN_URL=http://localhost:5173/login

# Free test “email”: Nodemailer Ethereal (needs internet). After signup, copy the preview URL from the server console.
MAIL_USE_ETHEREAL=true
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_SECURE=false
# MAIL_USER=
# MAIL_PASS=
# MAIL_FROM="SYADA <noreply@your-domain.com>"
# When Ethereal is off and MAIL_HOST is unset, new member passwords are printed in the Node console automatically.
# LOG_PORTAL_PASSWORD=1  → also log password when email was sent (debug only). LOG_PORTAL_PASSWORD=0 → never log.